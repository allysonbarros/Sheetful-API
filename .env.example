# Google credentials — at least one is required.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SERVICE_ACCOUNT_KEY=path_to_service_account_key.json

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS — comma-separated list. Do NOT use "*" together with ALLOW_CREDENTIALS=true.
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=
ALLOW_CREDENTIALS=false
