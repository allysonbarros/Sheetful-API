[flake8]
# Align with black (line-length 88) and drop rules that conflict with it.
# - E203: whitespace before ':' — black formats slices with spaces; PEP8 is wrong here.
# - W503: line break before binary operator — black does the opposite and W504 is preferred.
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    .mypy_cache,
    .pytest_cache
per-file-ignores =
    # main.py re-exports ``app`` so ``uvicorn main:app`` works.
    main.py: F401
